{
  "FormTitle": "問題反饋",
  "Version": "1.0.0",
  "Controls": [
    {
      "ID": "Product",
      "Type": "ComboBox",
      "Label": "反應產品",
      "Required": true,
      "Items": [
        "Feedback Assistant",
        "Data Helper",
        "Money Statistics",
        "其它"
      ]
    },
    {
      "ID": "Version",
      "Type": "TextBox",
      "Label": "問題版本",
      "Placeholder": "例如：1.2.5",
      "Required": true,
      "MaxLength": 30
    },
    {
      "ID": "Category",
      "Type": "ComboBox",
      "Label": "問題項目",
      "Required": true,
      "Items": [
        "程式錯誤(Bug)",
        "功能建議",
        "介面問題",
        "效能問題",
        "其它"
      ]
    },
    {
      "ID": "Feedback",
      "Type": "Multiline",
      "Label": "反饋問題",
      "Placeholder": "請詳細描述問題...",
      "Required": true,
      "Height": 150,
      "MaxLength": 5000
    }
  ]
}